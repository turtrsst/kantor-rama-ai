# Dependencies
node_modules/
vendor/
# web/vendor holds runtime assets (Three.js) that must ship with the site.
!web/vendor/

# Local configuration & credentials
api/config.local.json
api/config.json
api/integrations.local.json
api/integrations.local.*.tmp
.env
*.local

# Cache and logs
*.log
.cache/
.temp/

# OS artifacts
Thumbs.db
Desktop.ini
.DS_Store

# Bundled GitHub Changer runtime (tokens, sessions, activity log)
github-changer/.env
github-changer/data/
github-changer/*.log

# Bundled RNA Router runtime (Next.js build, env, logs)
rna-router/.env.local
rna-router/.next/
rna-router/node_modules/
rna-router/*.log
rna-router/rna.pid
rna-router/rna-fallback-log.txt
rna-router/.kra-secrets.env

# Instalasi RNA Router lama (folder "rnarouter", bukan bundel repo).
# Script automation disalin ke sana oleh Install RNA Router Automation.bat.
rnarouter/

# Superbots Agent (Python AutoGen 6-bot virtual office) runtime.
# .env menyimpan kredensial LLM/Telegram/YouTube; artefak runtime tidak di-commit.
superbots-agent/.env
superbots-agent/workspace/*
!superbots-agent/workspace/.gitkeep
superbots-agent/input_creator/*
!superbots-agent/input_creator/.gitkeep
superbots-agent/output_ready/*
!superbots-agent/output_ready/.gitkeep
superbots-agent/logs/*
!superbots-agent/logs/.gitkeep
superbots-agent/**/__pycache__/
superbots-agent/**/*.py[cod]
superbots-agent/.venv/
superbots-agent/venv/
superbots-agent/.pytest_cache/
superbots-agent/.mypy_cache/
superbots-agent/.ruff_cache/
superbots-agent/*.egg-info/

# Python cache di root KRA (kra_*.py stub modules).
__pycache__/
*.py[cod]
