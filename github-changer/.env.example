# Salin ke .env (opsional). Semua parameter juga bisa diatur lewat halaman Parameters di UI.
# Nilai dari environment selalu menang atas config file dan ditandai "env" di UI.

# --- Server ---
HOST=0.0.0.0
PORT=4173

# --- GitHub OAuth (WAJIB untuk login GitHub asli) ---
# Buat OAuth App di https://github.com/settings/developers
# lalu centang "Enable Device Flow". Client ID saja, TANPA client secret.
GITHUB_CLIENT_ID=

# --- Keamanan (opsional) ---
# Kunci enkripsi token di disk. Kalau kosong, dibuat otomatis di data/secret.key (mode 0600).
APP_SECRET=
# PIN tambahan untuk membuka app (opsional, dikirim lewat header X-App-Pin).
APP_PIN=

# --- Git di komputer/server (opsional, auto-detect kalau kosong) ---
# Windows: kalau Git tidak ada di PATH, isi path absolut, mis:
# GHC_GIT_BINARY=C:\Program Files\Git\cmd\git.exe
GHC_GIT_BINARY=git
# Host untuk autentikasi push/pull (default github.com; ganti untuk GHE)
GHC_GIT_HOST=github.com
# Beberapa root dipisah ";" di Windows, ":" di Linux/macOS
# GHC_WORKSPACE_ROOTS=C:\xampp\htdocs\github-changer;C:\xampp\htdocs
GHC_WORKSPACE_ROOTS=
GHC_DATA_DIR=

# --- Jembatan Kantor-Rama-AI (KRA) · tambahan bundle KRA -------------------
# Kunci bersama untuk endpoint mesin-ke-mesin /api/kra/* yang dipanggil
# api/lib/KraGitHubChangerClient.php. Wajib SAMA dengan integrasi KRA
# (KRA_GITHUB_CHANGER_API_KEY / form GitHub Changer di UI KRA).
# Kosong = jembatan NONAKTIF (endpoint menjawab 503).
KRA_GHC_API_KEY=

# Notifikasi hasil automasi (git pull/fetch/push) ke KRA, ditandatangani HMAC.
# Isi keduanya untuk mengaktifkan; secret harus SAMA dengan
# KRA_GITHUB_CHANGER_EVENT_SECRET pada server PHP KRA.
# URL default: http://127.0.0.1:8088/api/index.php?action=github-changer-event
KRA_GHC_EVENT_URL=
KRA_GHC_EVENT_SECRET=
