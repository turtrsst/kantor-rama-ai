{
  "name": "kantor-rama-ai",
  "version": "0.1.0",
  "description": "Kantor-Rama-AI (KRA) - Virtual Office Multi-Agent Desktop Harness",
  "author": "Kantor-Rama-AI",
  "license": "MIT",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "web": "php -S 127.0.0.1:8080 -t .",
    "n100n": "node --env-file=n100n/.env n100n/server.js",
    "n100n:test": "node --test n100n/tests/*.test.js",
    "verify:n100n-bundle": "node tools/verify-n100n-bundle.js",
    "github-changer": "node github-changer/server/index.js",
    "github-changer:doctor": "node github-changer/scripts/doctor.js",
    "github-changer:pair": "node github-changer/scripts/pair-kra.js",
    "github-changer:test": "node github-changer/scripts/smoke-test.js",
    "verify:github-changer-bundle": "node tools/verify-github-changer-bundle.js",
    "audit": "php tools/audit-cli.php",
    "verify:colony": "node tools/verify-colony-layout.js && node tools/verify-three-office-renderer.js",
    "verify:vault-settings": "node tools/verify-vault-settings.js",
    "verify:chat-modes": "node tools/verify-chat-modes.js",
    "verify:creator-roster": "node tools/verify-creator-roster.js",
    "verify:header-ui": "node tools/verify-header-ui.js",
    "verify:office-roster-drawer": "node tools/verify-office-roster-drawer.js",
    "verify:server-security": "node tools/verify-server-security.js",
    "verify:commercial": "node tools/verify-commercial-workspace.js",
    "license:keygen": "php tools/license-issue.php keygen",
    "license:issue": "php tools/license-issue.php issue"
  },
  "devDependencies": {
    "electron": "^34.0.0"
  }
}
