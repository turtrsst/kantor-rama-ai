# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# RNA Router Config (optional defaults for free tiers)
RNA_DEFAULT_MODEL=muse-spark-1.2-free
RNA_FALLBACK_ORDER=muse-spark-1.2-free,agnes,gemini-flash,deepseek,inkling

# Platform integrations (webhook URLs for KRA etc)
KRA_WEBHOOK_URL=https://kra.kantor-rama-ai.id/api/v1/webhook
KRA_API_KEY=your-kra-api-key
JWT_SECRET=rna-jwt-secret-key-change-in-production
# MySQL (alternative to Supabase)
DB_HOST=localhost
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=rna_router
