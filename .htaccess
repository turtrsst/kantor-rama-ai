
# KRA SECURITY: block sensitive project files
<IfModule mod_authz_core.c>
    <FilesMatch "^(\.git|\.env|\.htaccess|\.htpasswd)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.git(/|$) - [F,L,NC]
    RewriteRule ^\.temp(/|$) - [F,L,NC]
</IfModule>



<IfModule mod_mime.c>
    AddType application/javascript .mjs
</IfModule>

# Fingerprinted static assets are cached by the browser and CacheStorage. Bump
# the asset version in web/kra_asset_cache.js when shipped asset bytes change.
<IfModule mod_headers.c>
    <FilesMatch "\.(png|jpe?g|webp|gif|json|js|mjs|css|woff2?|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# --- KRA database env (dev XAMPP) ---
<IfModule mod_env.c>
    SetEnv KRA_DB_HOST 127.0.0.1
    SetEnv KRA_DB_USER root
    SetEnv KRA_SIAS_DB sias
</IfModule>
